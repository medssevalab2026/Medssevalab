{
  "expo": {
    "name": "MedsSeva",
    "slug": "medsseva-app",
    "version": "1.0.5",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "medssevaapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medssevaglobal.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medssevaglobal.app",
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/adaptive-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#006D6F",
          "dark": {
            "backgroundColor": "#006D6F"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      "./plugins/fixFirebaseMessagingManifest.js",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MedSeva needs access to your photos to upload prescriptions.",
          "cameraPermission": "MedSeva needs access to your camera to capture prescriptions.",
          "microphonePermission": false
        }
      ],
      "./plugins/stripMediaPermissions.js",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MedSeva uses your location to show nearby branches and assign the closest sample collection partner.",
          "locationWhenInUsePermission": "MedSeva uses your location to show nearby branches and assign the closest sample collection partner.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#006D6F",
          "sounds": [],
          "mode": "production",
          "androidMode": "default",
          "androidCollapsedTitle": "MedSeva",
          "androidChannels": [
            {
              "name": "general",
              "importance": 4,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "bookings",
              "importance": 5,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "reports",
              "importance": 4,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "chat",
              "importance": 4,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            },
            {
              "name": "payments",
              "importance": 5,
              "vibrationPattern": [
                0,
                250,
                250,
                250
              ],
              "lightColor": "#006D6F"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-sharing",
      "expo-web-browser",
      "expo-background-task",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9eb743e2-0160-4fb7-9c54-9ff354c44563"
      }
    },
    "owner": "developer04"
  }
}